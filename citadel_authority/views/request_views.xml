<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_citadel_authority_request_list" model="ir.ui.view">
        <field name="name">citadel.authority.request.list</field>
        <field name="model">citadel.authority.request</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-info="state == 'pending'" decoration-success="state in ('approved', 'completed')"
                  decoration-danger="state == 'rejected'" decoration-muted="state in ('invalidated', 'cancelled')">
                <field name="name"/>
                <field name="submitted_on"/>
                <field name="document_type"/>
                <field name="document_name"/>
                <field name="policy_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount"/>
                <field name="requested_by_id"/>
                <field name="approved_by_display" optional="hide"/>
                <field name="next_approval_display" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_citadel_authority_request_search" model="ir.ui.view">
        <field name="name">citadel.authority.request.search</field>
        <field name="model">citadel.authority.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="document_name"/>
                <field name="policy_id"/>
                <field name="requested_by_id"/>
                <filter name="pending" string="قيد الانتظار" domain="[('state', '=', 'pending')]"/>
                <filter name="mine" string="طلباتي" domain="[('requested_by_id', '=', uid)]"/>
                <filter name="approved" string="تم الاعتماد" domain="[('state', 'in', ('approved', 'completed'))]"/>
                <separator/>
                <filter name="rejected" string="مرفوض" domain="[('state', '=', 'rejected')]"/>
                <group>
                    <filter name="group_type" string="نوع المستند" context="{'group_by': 'document_type'}"/>
                    <filter name="group_state" string="الحالة" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="الشركة" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_citadel_authority_request_form" model="ir.ui.view">
        <field name="name">citadel.authority.request.form</field>
        <field name="model">citadel.authority.request</field>
        <field name="arch" type="xml">
            <form string="طلب صلاحية" create="0" edit="0" delete="0">
                <header>
                    <button name="action_approve" type="object" string="اعتماد" class="btn-success"
                            invisible="not can_approve or state != 'pending'"/>
                    <button name="action_open_reject_wizard" type="object" string="رفض" class="btn-danger"
                            invisible="not can_reject or state != 'pending'"/>
                    <button name="action_cancel" type="object" string="سحب"
                            invisible="not can_cancel or state != 'pending'"/>
                    <button name="action_open_document" type="object" string="فتح المستند"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected,completed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1><h2><field name="document_name"/></h2></div>
                    <field name="can_approve" invisible="True"/>
                    <field name="can_reject" invisible="True"/>
                    <field name="can_cancel" invisible="True"/>
                    <group>
                        <group>
                            <field name="document_type"/>
                            <field name="policy_id"/>
                            <field name="requested_by_id"/>
                            <field name="submitted_on"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="True"/>
                            <field name="amount"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="decided_on"/>
                            <field name="snapshot_hash" groups="base.group_system"/>
                        </group>
                    </group>
                    <field name="rejection_reason" invisible="not rejection_reason"/>
                    <group string="مسار الاعتماد" invisible="not approval_timeline" col="1">
                        <field name="approval_timeline" widget="html" nolabel="1" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="خطوات الاعتماد">
                            <field name="step_ids">
                                <list create="0" edit="0" delete="0">
                                    <field name="sequence"/>
                                    <field name="role_id"/>
                                    <field name="approval_mode"/>
                                    <field name="required_approvals"/>
                                    <field name="eligible_user_ids" widget="many2many_tags_avatar"/>
                                    <field name="vote_count"/>
                                    <field name="due_on" optional="show"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="قرارات الاعتماد">
                            <field name="step_ids" mode="list">
                                <list create="0" edit="0" delete="0">
                                    <field name="sequence"/>
                                    <field name="role_id"/>
                                    <field name="vote_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                        <page string="سجل التدقيق">
                            <field name="log_ids">
                                <list create="0" edit="0" delete="0">
                                    <field name="occurred_on"/>
                                    <field name="event"/>
                                    <field name="step_id" optional="show"/>
                                    <field name="actor_id"/>
                                    <field name="principal_id" optional="show"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_citadel_authority_request" model="ir.actions.act_window">
        <field name="name">جميع الاعتمادات</field>
        <field name="res_model">citadel.authority.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_citadel_authority_request_search"/>
    </record>
    <record id="action_citadel_authority_waiting" model="ir.actions.act_window">
        <field name="name">بانتظار اعتمادي</field>
        <field name="res_model">citadel.authority.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('waiting_for_me', '=', True)]</field>
        <field name="search_view_id" ref="view_citadel_authority_request_search"/>
    </record>

    <record id="view_citadel_authority_reject_wizard_form" model="ir.ui.view">
        <field name="name">citadel.authority.reject.wizard.form</field>
        <field name="model">citadel.authority.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="رفض الاعتماد">
                <group>
                    <field name="request_id"/>
                    <field name="reason_required" invisible="True"/>
                    <field name="reason" string="سبب الرفض" placeholder="اشرح سبب رفض المستند..."
                           required="reason_required"/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="رفض" class="btn-danger"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

