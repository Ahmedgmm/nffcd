<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_citadel_authority" model="ir.module.category">
        <field name="name">Authority</field>
        <field name="sequence">35</field>
    </record>
    <record id="privilege_citadel_authority" model="res.groups.privilege">
        <field name="name">Authority</field>
        <field name="category_id" ref="module_category_citadel_authority"/>
        <field name="sequence">35</field>
    </record>

    <record id="group_citadel_authority_user" model="res.groups">
        <field name="name">Authority User</field>
        <field name="privilege_id" ref="privilege_citadel_authority"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_citadel_authority_manager" model="res.groups">
        <field name="name">Authority Manager</field>
        <field name="privilege_id" ref="privilege_citadel_authority"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_citadel_authority_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_citadel_authority_manager'))]"/>
    </record>

</odoo>

