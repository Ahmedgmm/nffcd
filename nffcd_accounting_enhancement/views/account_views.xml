<odoo>
    <record id="view_journal_cash_funds" model="ir.ui.view">
        <field name="name">account.journal.cash.funds</field><field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml"><notebook position="inside">
            <page string="Cash Classifications" invisible="type != 'cash'">
                <field name="cash_fund_ids" context="{'default_journal_id': id}">
                    <list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/>
                        <field name="allow_negative"/><field name="currency_id" column_invisible="True"/>
                        <field name="balance"/><field name="is_general" readonly="1"/>
                    </list>
                </field>
            </page>
        </notebook></field>
    </record>
    <record id="view_move_cash_funds" model="ir.ui.view">
        <field name="name">account.move.cash.funds</field><field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='account_id']" position="after">
                <field name="cash_journal_id" column_invisible="True"/>
                <field name="cash_fund_id" optional="show" readonly="parent.state != 'draft'"
                       invisible="not cash_journal_id" domain="[('journal_id', '=', cash_journal_id)]"
                       context="{'default_journal_id': cash_journal_id}"/>
            </xpath>
        </field>
    </record>
</odoo>
