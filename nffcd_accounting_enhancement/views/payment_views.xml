<odoo>
    <record id="view_payment_cash_funds" model="ir.ui.view">
        <field name="name">account.payment.cash.funds</field><field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="payment_type" position="replace">
                <field name="payment_type" invisible="1"/>
                <field name="cash_is_internal_transfer" invisible="1"/>
                <field name="cash_operation" widget="radio" options="{'horizontal': True}"
                       readonly="state != 'draft' or paired_internal_transfer_payment_id"/>
            </field>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible" add="cash_is_internal_transfer" separator=" or "/>
            </xpath>
            <field name="payment_method_line_id" position="after">
                <field name="cash_journal_type" invisible="1"/>
                <field name="cash_split" invisible="1"/>
                <field name="cash_fund_id" invisible="cash_journal_type != 'cash' or cash_split"
                       readonly="state != 'draft' or paired_internal_transfer_payment_id"
                       domain="[('journal_id', '=', journal_id)]"
                       context="{'default_journal_id': journal_id, 'default_company_id': company_id}"
                       required="cash_journal_type == 'cash' and not cash_split"/>
                <field name="cash_fund_balance" invisible="cash_journal_type != 'cash' or cash_split"/>
                <button name="action_toggle_cash_split" string="Split Amount / توزيع المبلغ" type="object"
                        class="btn-link" invisible="cash_journal_type != 'cash' or state != 'draft' or paired_internal_transfer_payment_id"/>
                <field name="cash_destination_journal_id" invisible="not cash_is_internal_transfer"
                       required="cash_is_internal_transfer" readonly="state != 'draft' or paired_internal_transfer_payment_id"
                       domain="[('type', 'in', ['cash', 'bank']), ('company_id', '=', company_id), ('id', '!=', journal_id)]"/>
                <field name="cash_destination_type" invisible="1"/>
                <field name="cash_destination_split" invisible="1"/>
                <field name="cash_destination_fund_id"
                       invisible="not cash_is_internal_transfer or cash_destination_type != 'cash' or cash_destination_split"
                       required="cash_is_internal_transfer and cash_destination_type == 'cash' and not cash_destination_split"
                       readonly="state != 'draft' or paired_internal_transfer_payment_id"
                       domain="[('journal_id', '=', cash_destination_journal_id)]"
                       context="{'default_journal_id': cash_destination_journal_id}"/>
                <button name="action_toggle_destination_split" string="Split Destination Amount / توزيع المبلغ المستلم"
                        type="object" class="btn-link"
                        invisible="not cash_is_internal_transfer or cash_destination_type != 'cash' or state != 'draft' or paired_internal_transfer_payment_id"/>
            </field>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_cash_pair" type="object" class="oe_stat_button" icon="fa-exchange"
                        string="Linked Transfer" invisible="not paired_internal_transfer_payment_id"/>
            </xpath>
            <xpath expr="//notebook[@name='payment_notebook']" position="inside">
                <page string="Classification Split" invisible="not cash_split or cash_journal_type != 'cash'">
                    <field name="cash_allocation_ids" readonly="state != 'draft' or paired_internal_transfer_payment_id">
                        <list editable="bottom">
                            <field name="journal_id" column_invisible="True"/><field name="currency_id" column_invisible="True"/>
                            <field name="fund_id" domain="[('journal_id', '=', parent.journal_id)]"
                                   context="{'default_journal_id': parent.journal_id}"/>
                            <field name="amount" sum="Total"/>
                        </list>
                    </field>
                </page>
                <page string="Destination Split" invisible="not cash_is_internal_transfer or not cash_destination_split or cash_destination_type != 'cash'">
                    <field name="cash_destination_allocation_ids" readonly="state != 'draft' or paired_internal_transfer_payment_id">
                        <list editable="bottom">
                            <field name="currency_id" column_invisible="True"/>
                            <field name="fund_id" domain="[('journal_id', '=', parent.cash_destination_journal_id)]"
                                   context="{'default_journal_id': parent.cash_destination_journal_id}"/>
                            <field name="amount" sum="Total"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_payment_cash_funds_list" model="ir.ui.view">
        <field name="name">account.payment.cash.funds.list</field><field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml"><field name="journal_id" position="after">
            <field name="cash_operation" optional="show"/><field name="cash_fund_id" optional="show"/>
            <field name="cash_split" optional="hide"/><field name="cash_destination_journal_id" optional="hide"/>
        </field></field>
    </record>
    <record id="view_payment_cash_funds_search" model="ir.ui.view">
        <field name="name">account.payment.cash.funds.search</field><field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml"><search position="inside">
            <field name="cash_fund_id"/>
            <filter name="cash_transfers" string="Internal Transfers" domain="[('cash_is_internal_transfer', '=', True)]"/>
        </search></field>
    </record>
    <record id="view_register_cash_fund" model="ir.ui.view">
        <field name="name">account.payment.register.cash.fund</field><field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml"><field name="payment_method_line_id" position="after">
            <field name="cash_journal_type" invisible="1"/>
            <field name="cash_fund_id" invisible="cash_journal_type != 'cash' or cash_split" required="cash_journal_type == 'cash' and not cash_split"
                   domain="[('journal_id', '=', journal_id)]" context="{'default_journal_id': journal_id}"/>
            <field name="cash_split" invisible="cash_journal_type != 'cash'"/>
            <field name="cash_allocation_ids" invisible="cash_journal_type != 'cash' or not cash_split">
                <list editable="bottom"><field name="currency_id" column_invisible="True"/>
                    <field name="fund_id" domain="[('journal_id', '=', parent.journal_id)]"
                           context="{'default_journal_id': parent.journal_id}"/>
                    <field name="amount" sum="Total"/>
                </list>
            </field>
        </field></field>
    </record>
</odoo>
