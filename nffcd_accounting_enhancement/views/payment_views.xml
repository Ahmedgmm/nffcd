<odoo>
    <record id="view_payment_cash_funds" model="ir.ui.view">
        <field name="name">account.payment.cash.funds</field><field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="payment_type" position="replace">
                <field name="payment_type" invisible="1"/>
                <field name="cash_is_internal_transfer" invisible="1"/>
                <field name="cash_operation" widget="badges_selection"
                       readonly="state != 'draft' or paired_internal_transfer_payment_id"/>
            </field>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible" add="cash_is_internal_transfer" separator=" or "/>
            </xpath>
            <field name="payment_method_line_id" position="after">
                <field name="cash_journal_type" invisible="1"/>
                <field name="cash_destination_type" invisible="1"/>

                <!-- Source safe: classification + balance + split toggle on one line -->
                <label for="cash_fund_id" invisible="cash_journal_type != 'cash'"/>
                <div class="o_nffcd_row" name="cash_fund_row" invisible="cash_journal_type != 'cash'">
                    <field name="cash_fund_id" invisible="cash_split"
                           readonly="state != 'draft' or paired_internal_transfer_payment_id"
                           domain="[('journal_id', '=', journal_id)]"
                           context="{'default_journal_id': journal_id, 'default_company_id': company_id}"
                           required="cash_journal_type == 'cash' and not cash_split"
                           options="{'no_quick_create': True}"/>
                    <span class="text-muted fst-italic" invisible="not cash_split">Split across classifications</span>
                    <span class="badge rounded-pill text-bg-light text-nowrap flex-grow-0"
                          invisible="cash_split or not cash_fund_id" title="Classification Balance">
                        <field name="cash_fund_balance" class="d-inline"/>
                    </span>
                    <field name="cash_split" widget="boolean_icon" options="{'icon': 'fork_right'}"
                           class="flex-grow-0" nolabel="1"
                           invisible="state != 'draft' or paired_internal_transfer_payment_id"/>
                </div>

                <!-- Internal transfer destination -->
                <field name="cash_destination_journal_id" invisible="not cash_is_internal_transfer"
                       required="cash_is_internal_transfer" readonly="state != 'draft' or paired_internal_transfer_payment_id"
                       domain="[('type', 'in', ['cash', 'bank']), ('company_id', '=', company_id), ('id', '!=', journal_id)]"
                       options="{'no_create': True}"/>
                <label for="cash_destination_fund_id"
                       invisible="not cash_is_internal_transfer or cash_destination_type != 'cash'"/>
                <div class="o_nffcd_row" name="cash_destination_fund_row"
                     invisible="not cash_is_internal_transfer or cash_destination_type != 'cash'">
                    <field name="cash_destination_fund_id" invisible="cash_destination_split"
                           required="cash_is_internal_transfer and cash_destination_type == 'cash' and not cash_destination_split"
                           readonly="state != 'draft' or paired_internal_transfer_payment_id"
                           domain="[('journal_id', '=', cash_destination_journal_id)]"
                           context="{'default_journal_id': cash_destination_journal_id}"
                           options="{'no_quick_create': True}"/>
                    <span class="text-muted fst-italic" invisible="not cash_destination_split">Split across classifications</span>
                    <field name="cash_destination_split" widget="boolean_icon" options="{'icon': 'fork_right'}"
                           class="flex-grow-0" nolabel="1"
                           invisible="state != 'draft' or paired_internal_transfer_payment_id"/>
                </div>
            </field>
            <xpath expr="//div[@name='amount_div']" position="attributes">
                <attribute name="class">o_nffcd_row</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_cash_pair" type="object" class="oe_stat_button" icon="swap_horiz"
                        string="Linked Transfer" invisible="not paired_internal_transfer_payment_id"/>
            </xpath>
            <!-- Split tables sit right under the header fields, not hidden in a tab -->
            <xpath expr="//group[@name='main_group']" position="after">
                <div name="cash_split_section" class="mb-4"
                     invisible="not cash_split or cash_journal_type != 'cash'">
                    <div class="d-flex flex-wrap align-items-center gap-2 border-bottom pb-1 mb-2">
                        <h5 class="mb-0 me-auto">Classification Split</h5>
                        <span class="badge rounded-pill text-bg-success" invisible="not cash_split_balanced">Fully allocated</span>
                        <span class="badge rounded-pill text-bg-warning" invisible="cash_split_balanced">
                            Remaining to allocate: <field name="cash_split_remaining" class="d-inline"/>
                        </span>
                    </div>
                    <field name="cash_allocation_ids" nolabel="1"
                           readonly="state != 'draft' or paired_internal_transfer_payment_id">
                        <list editable="bottom">
                            <field name="journal_id" column_invisible="True"/><field name="currency_id" column_invisible="True"/>
                            <field name="fund_id" domain="[('journal_id', '=', parent.journal_id)]"
                                   context="{'default_journal_id': parent.journal_id}"
                                   options="{'no_quick_create': True}"/>
                            <field name="amount" sum="Total"/>
                        </list>
                    </field>
                </div>
                <div name="cash_destination_split_section" class="mb-4"
                     invisible="not cash_is_internal_transfer or not cash_destination_split or cash_destination_type != 'cash'">
                    <div class="d-flex flex-wrap align-items-center gap-2 border-bottom pb-1 mb-2">
                        <h5 class="mb-0 me-auto">Destination Split</h5>
                        <span class="badge rounded-pill text-bg-success" invisible="not cash_destination_split_balanced">Fully allocated</span>
                        <span class="badge rounded-pill text-bg-warning" invisible="cash_destination_split_balanced">
                            Remaining to allocate: <field name="cash_destination_split_remaining" class="d-inline"/>
                        </span>
                    </div>
                    <field name="cash_destination_allocation_ids" nolabel="1"
                           readonly="state != 'draft' or paired_internal_transfer_payment_id">
                        <list editable="bottom">
                            <field name="currency_id" column_invisible="True"/>
                            <field name="fund_id" domain="[('journal_id', '=', parent.cash_destination_journal_id)]"
                                   context="{'default_journal_id': parent.cash_destination_journal_id}"
                                   options="{'no_quick_create': True}"/>
                            <field name="amount" sum="Total"/>
                        </list>
                    </field>
                </div>
            </xpath>
        </field>
    </record>
    <record id="view_payment_cash_funds_list" model="ir.ui.view">
        <field name="name">account.payment.cash.funds.list</field><field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml"><field name="journal_id" position="after">
            <field name="cash_operation" optional="show"/><field name="cash_fund_id" optional="show"/>
            <field name="cash_split" optional="hide"/><field name="cash_destination_journal_id" optional="hide"/>
        </field></field>
    </record>
    <record id="view_payment_cash_funds_search" model="ir.ui.view">
        <field name="name">account.payment.cash.funds.search</field><field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml"><search position="inside">
            <field name="cash_fund_id"/>
            <filter name="cash_transfers" string="Internal Transfers" domain="[('cash_is_internal_transfer', '=', True)]"/>
        </search></field>
    </record>
    <record id="view_register_cash_fund" model="ir.ui.view">
        <field name="name">account.payment.register.cash.fund</field><field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml"><field name="payment_method_line_id" position="after">
            <field name="cash_journal_type" invisible="1"/>
            <label for="cash_fund_id" invisible="cash_journal_type != 'cash'"/>
            <div class="o_nffcd_row" invisible="cash_journal_type != 'cash'">
                <field name="cash_fund_id" invisible="cash_split" required="cash_journal_type == 'cash' and not cash_split"
                       domain="[('journal_id', '=', journal_id)]" context="{'default_journal_id': journal_id}"
                       options="{'no_quick_create': True}"/>
                <span class="text-muted fst-italic" invisible="not cash_split">Split across classifications</span>
                <field name="cash_split" widget="boolean_icon" options="{'icon': 'fork_right'}" class="flex-grow-0" nolabel="1"/>
            </div>
            <field name="cash_allocation_ids" colspan="2" nolabel="1" invisible="cash_journal_type != 'cash' or not cash_split">
                <list editable="bottom"><field name="currency_id" column_invisible="True"/>
                    <field name="fund_id" domain="[('journal_id', '=', parent.journal_id)]"
                           context="{'default_journal_id': parent.journal_id}" options="{'no_quick_create': True}"/>
                    <field name="amount" sum="Total"/>
                </list>
            </field>
        </field></field>
    </record>
</odoo>
