<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_eh_bank_sync_review_list" model="ir.ui.view">
        <field name="name">eh.bank.sync.review.list</field>
        <field name="model">eh.bank.sync.review</field>
        <field name="arch" type="xml">
            <list string="Bank Feed Changes" create="0" delete="0" decoration-muted="state == 'acknowledged'">
                <field name="create_date" string="Received"/>
                <field name="journal_id"/>
                <field name="provider_reference"/>
                <field name="change_kind"/>
                <field name="original_date"/>
                <field name="original_amount"/>
                <field name="proposed_date"/>
                <field name="proposed_amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge" decoration-warning="state == 'open'" decoration-success="state == 'acknowledged'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_eh_bank_sync_review_search" model="ir.ui.view">
        <field name="name">eh.bank.sync.review.search</field>
        <field name="model">eh.bank.sync.review</field>
        <field name="arch" type="xml">
            <search><field name="provider_reference"/><field name="journal_id"/><field name="profile_id"/>
                <filter name="open" string="Needs review" domain="[('state','=','open')]"/>
                <filter name="reviewed" string="Reviewed" domain="[('state','=','acknowledged')]"/>
                <group><filter name="journal" string="Bank" context="{'group_by':'journal_id'}"/>
                    <filter name="kind" string="Change" context="{'group_by':'change_kind'}"/></group>
            </search>
        </field>
    </record>
    <record id="view_eh_bank_sync_review_form" model="ir.ui.view">
        <field name="name">eh.bank.sync.review.form</field>
        <field name="model">eh.bank.sync.review</field>
        <field name="arch" type="xml">
            <form string="Bank Feed Change" create="0" delete="0">
                <header><button name="action_acknowledge" string="Mark reviewed" type="object" class="btn-primary" groups="eh_account_base.group_eh_manager" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"/></header>
                <sheet>
                    <div class="alert alert-info" role="alert">The bank changed an imported transaction. The accounting entry has been preserved. Review the evidence, make any necessary accounting adjustment through your normal process, and record your decision below. Marking this change reviewed does not alter the ledger.</div>
                    <group><group><field name="profile_id"/><field name="journal_id"/><field name="company_id" groups="base.group_multi_company"/><field name="provider_reference"/><field name="change_kind"/></group>
                        <group><field name="statement_line_id"/><field name="create_date"/><field name="reviewed_by_id"/><field name="reviewed_at"/><field name="currency_id" invisible="True"/></group></group>
                    <group><group string="Recorded transaction"><field name="original_date"/><field name="original_amount"/></group>
                        <group string="Bank change"><field name="proposed_date" invisible="change_kind == 'removed'"/><field name="proposed_amount" invisible="change_kind == 'removed'"/><field name="proposed_description" invisible="change_kind == 'removed'"/></group></group>
                    <group string="Review decision"><field name="resolution_note" nolabel="1" placeholder="Explain the decision and reference any accounting adjustment."/></group>
                    <notebook><page string="Saved evidence"><field name="evidence_json" widget="text"/></page></notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_eh_bank_sync_review" model="ir.actions.act_window">
        <field name="name">Bank Feed Changes</field><field name="res_model">eh.bank.sync.review</field>
        <field name="view_mode">list,form</field><field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No bank feed changes need review.</p><p>Corrections and removals from your bank appear here while your accounting entries stay intact.</p></field>
    </record>
</odoo>
