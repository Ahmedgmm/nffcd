<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="action_report_eh_deferred_tax_ias12_note"
            model="ir.actions.report">
        <field name="name">IAS 12 Deferred Tax Note</field>
        <field name="model">eh.deferred.tax.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">eh_account_deferred_tax.report_deferred_tax_ias12_note</field>
        <field name="binding_model_id" ref="model_eh_deferred_tax_run"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'IAS 12 Note - %s' % (object.name)</field>
        <!-- Without a format of its own a report prints on whatever paper the
             reader's company is set to, so the same note comes out on A4 for
             one company and Letter for another. Ten columns of temporary
             differences need the landscape width either way. -->
        <field name="paperformat_id"
               ref="eh_account_base.paperformat_eh_landscape"/>
    </record>

    <template id="report_deferred_tax_ias12_note">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- Ask the letterhead and the page footer to print in installed
                     faces: see eh_account_base.eh_report_letterhead_fonts. -->
                <t t-set="eh_pin_report_fonts" t-value="True"/>
                <t t-call="web.external_layout" company="(o.company_id or env.company).sudo()">
                    <!-- The suite stylesheet pins the report body to installed font
                         faces. Without it the body inherits the downloadable company
                         font, and any face the PDF engine cannot embed is dropped from
                         the page with no error, taking its text with it. -->
                    <t t-call="eh_account_base.eh_report_styles"/>
                    <div class="page">
                        <h2>IAS 12 Deferred Tax Note</h2>
                        <p>
                            <strong>Company:</strong>
                            <span t-field="o.company_id"/>
                            <br/>
                            <strong>Reporting date:</strong>
                            <span t-field="o.period_end"/>
                            <br/>
                            <strong>Currency:</strong>
                            <span t-field="o.currency_id"/>
                        </p>
                        <p>
                            This table discloses temporary differences by type
                            and expiry band, with both gross amounts and their
                            recognised or unrecognised tax effects (IAS
                            12.81(e)/(g)).
                        </p>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Expiry band</th>
                                    <th class="text-end">Gross deductible</th>
                                    <th class="text-end">Gross taxable</th>
                                    <th class="text-end">Recognised DTA</th>
                                    <th class="text-end">Recognised DTL</th>
                                    <th class="text-end">Unrecognised gross</th>
                                    <th class="text-end">Unrecognised tax effect</th>
                                    <th class="text-end">P&amp;L movement</th>
                                    <th class="text-end">OCI movement</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="rows" t-value="o._ias12_disclosure_rows()"/>
                                <t t-if="not rows">
                                    <tr>
                                        <td colspan="10">No temporary differences.</td>
                                    </tr>
                                </t>
                                <tr t-foreach="rows" t-as="row">
                                    <td><span t-out="row['category_label']"/></td>
                                    <td><span t-out="row['expiry_label']"/></td>
                                    <td class="text-end"><span t-out="row['gross_deductible']"
                                          t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                    <td class="text-end"><span t-out="row['gross_taxable']"
                                          t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                    <td class="text-end"><span t-out="row['recognised_dta']"
                                          t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                    <td class="text-end"><span t-out="row['recognised_dtl']"
                                          t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                    <td class="text-end"><span t-out="row['unrecognised_gross']"
                                          t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                    <td class="text-end"><span t-out="row['unrecognised_dta']"
                                          t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                    <td class="text-end"><span t-out="row['pl_movement']"
                                          t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                    <td class="text-end"><span t-out="row['oci_movement']"
                                          t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <h3>Offsetting presentation</h3>
                        <!-- A note wider than the page would run off it without wrapping. -->
                        <pre style="white-space: pre-wrap; word-wrap: break-word;"
                             t-out="o.offsetting_note or ''"/>
                        <h3>Recoverability evidence</h3>
                        <p t-out="o.recoverability_memo or 'No memo entered.'"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
