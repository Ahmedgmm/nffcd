<odoo>
<record id="settlement_entries" model="ir.actions.act_window"><field name="name">Settlement Entries</field><field name="res_model">account.move</field><field name="view_mode">list,form</field><field name="domain">[('journal_id.type','=','settlement'),('move_type','=','entry')]</field><field name="context">{'default_move_type':'entry', 'nffcd_settlement_journal':True}</field></record>
<menuitem id="menu_settlement_entries" name="Settlement Entries" parent="account.menu_finance_entries" action="settlement_entries" groups="account.group_account_user"/>
<record id="opening_move_form" model="ir.ui.view"><field name="name">Opening entry designation</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//field[@name='ref']" position="after"><field name="settlement_opening" groups="account.group_account_manager" readonly="state != 'draft'"/></xpath></field></record>
<record id="legacy_list" model="ir.ui.view"><field name="name">Legacy classification list</field><field name="model">nffcd.legacy.purpose</field><field name="arch" type="xml"><list><field name="move_id"/><field name="company_id"/><field name="purpose"/><field name="evidence"/></list></field></record>
<record id="legacy_form" model="ir.ui.view"><field name="name">Legacy classification form</field><field name="model">nffcd.legacy.purpose</field><field name="arch" type="xml"><form><sheet><group><field name="move_id"/><field name="company_id"/><field name="purpose"/><field name="evidence"/></group></sheet><chatter/></form></field></record>
<record id="legacy_action" model="ir.actions.act_window"><field name="name">Reviewed Reporting Classifications</field><field name="res_model">nffcd.legacy.purpose</field><field name="view_mode">list,form</field></record>
<menuitem id="legacy_menu" name="Reviewed Reporting Classifications" parent="account.menu_finance_entries" action="legacy_action" groups="account.group_account_manager"/>
<record id="report_settlement_trial_balance" model="eh.account.dynamic.report"><field name="code">settlement_trial_balance</field><field name="name">Trial Balance with Settlements</field><field name="handler_model">eh.account.dynamic.report.handler.settlement_trial_balance</field><field name="sequence">11</field></record>
<record id="report_action" model="ir.actions.client"><field name="name">Trial Balance with Settlements</field><field name="tag">eh_account_dynamic_report</field><field name="context">{"report_code":"settlement_trial_balance"}</field></record>
<menuitem id="report_menu" name="Trial Balance with Settlements" parent="eh_account_dynamic_reports.menu_ledgers" action="report_action" groups="account.group_account_user"/>
<record id="settlement_journal_filter" model="ir.ui.view"><field name="name">Settlement journal filter</field><field name="model">account.journal</field><field name="inherit_id" ref="account.view_account_journal_search"/><field name="arch" type="xml"><xpath expr="//filter[@name='miscellaneous']" position="after"><filter name="settlement" string="Settlement Journals" domain="[('type','=','settlement')]"/></xpath></field></record>
<record id="settlement_move_filter" model="ir.ui.view"><field name="name">Settlement entry filter</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_account_move_filter"/><field name="arch" type="xml"><xpath expr="//filter[@name='misc_filter']" position="after"><filter name="settlement" string="Settlement Entries" domain="[('journal_id.type','=','settlement')]"/></xpath></field></record>
</odoo>
