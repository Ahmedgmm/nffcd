<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_bom_percentage_cost" model="ir.ui.view">
        <field name="name">product.template.form.nffcd.bom.percentage.cost</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="before">
                <field name="nffcd_is_bom_percentage_cost" invisible="type != 'service'"/>
                <label for="nffcd_bom_cost_percentage" invisible="not nffcd_is_bom_percentage_cost"/>
                <div class="d-flex align-items-baseline gap-2" invisible="not nffcd_is_bom_percentage_cost">
                    <field name="nffcd_bom_cost_percentage" class="oe_inline"
                           required="nffcd_is_bom_percentage_cost"/>
                    <span>%</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
