<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <div t-name="Purchasing_alternatives.AlternativeTable" class="o_action o_purchase_alternative">
        <ControlPanel>
        </ControlPanel>
        <div class="o-content overflow-auto o_alt_content">
            <div t-if="this.state.loading" class="o_alt_loading">
                <i class="fa fa-circle-o-notch fa-spin me-2"/> جارٍ تحميل العروض
            </div>
            <div t-else="">
                <div class="o_alt_hero">
                    <div>
                        <div class="o_alt_eyebrow">
                            <i class="fa fa-random me-1"/> مقارنة عروض الموردين
                        </div>
                        <h2 t-esc="this.state.data.name"/>
                        <div class="o_alt_meta">
                            <span><i class="fa fa-file-text-o me-1"/> طلب الشراء الأصلي: <strong t-esc="this.state.data.order.name"/></span>
                            <span><i class="fa fa-building-o me-1"/> المورد الحالي: <strong t-esc="this.state.data.order.partner"/></span>
                        </div>
                    </div>
                    <button class="btn btn-light border" t-on-click="this.openOriginal" t-if="this.state.data.order">
                        <i class="fa fa-external-link me-1"/> فتح طلب الشراء
                    </button>
                </div>

                <div class="o_alt_committee alert mb-2" t-att-class="this.authority.approved ? 'alert-success' : (this.authority.state === 'pending' ? 'alert-warning' : 'alert-info')">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <i class="fa fa-gavel"/>
                        <strong>لجنة البت والمفاضلة:</strong>
                        <span t-esc="this.authority.committee or 'لم تُحدد اللجنة'"/>
                        <span t-if="this.authority.chairman" class="text-muted">(الرئيس: <t t-esc="this.authority.chairman"/>)</span>
                        <span t-if="this.authority.decision" class="badge text-bg-light border">
                            <t t-esc="this.authority.decision"/>
                            <t t-if="this.authority.decision_vendor"> — <t t-esc="this.authority.decision_vendor"/></t>
                        </span>
                        <span t-if="this.authority.state === 'pending'">بانتظار: <t t-esc="this.authority.next"/></span>
                        <span t-if="this.authority.approved">تم الاعتماد: <t t-esc="this.authority.approved_by"/> — اضغط زر القرار مرة أخرى لتطبيقه.</span>
                        <span t-if="this.authority.state === 'rejected'">رفضت اللجنة القرار. عدّل العروض وأعد الإرسال.</span>
                        <span class="ms-auto d-flex gap-1">
                            <button t-if="this.authority.can_approve" class="btn btn-success btn-sm" t-on-click="this.approveDecision">
                                <i class="fa fa-check me-1"/> اعتماد
                            </button>
                            <button t-if="this.authority.can_approve" class="btn btn-danger btn-sm" t-on-click="() => this.callAction('action_citadel_reject')">رفض</button>
                            <button t-if="this.state.data.state === 'review'" class="btn btn-outline-secondary btn-sm" t-on-click="this.withdrawDecision">سحب القرار</button>
                            <button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.callAction('action_print_committee_minutes')">
                                <i class="fa fa-print me-1"/> المحضر
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.callAction('action_print_offers_sheet')">
                                <i class="fa fa-print me-1"/> كشف التفريغ
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.callAction('action_open_form')">
                                <i class="fa fa-pencil me-1"/> اللجنة
                            </button>
                        </span>
                    </div>
                    <div class="small mt-1" t-if="!this.authority.state">
                        اختر قرار اللجنة: «ترسية» للترسية على مورد واحد، أو «توزيع الكميات» لتوزيع الكميات على عدة موردين. يُرسل القرار لاعتماد جميع الأعضاء بالتوازي، ثم يُطبق بعد اكتمال الاعتماد.
                    </div>
                </div>

                <div class="o_alt_toolbar">
                    <div class="o_alt_hint">
                        <i class="fa fa-info-circle"/>
                        <span>أدخل الكميات والأسعار لكل مورد. اللون الأخضر يميز أفضل سعر، وشارة التوزيع توضح هل الكمية موزعة جزئياً أو بالكامل أو بالزيادة.</span>
                    </div>
                    <div class="o_alt_toolbar_actions">
                        <button class="btn btn-outline-primary btn-sm" t-on-click="this.addVendor" t-att-disabled="this.state.data.state !== 'draft' ? true : undefined">
                            <i class="fa fa-plus me-1"/> إضافة مورد
                        </button>
                        <button class="btn btn-primary btn-sm" t-on-click="this.createSplitPOs" t-att-disabled="this.state.data.state !== 'draft' and !this.isApprovedSplit()">
                            <t t-if="this.isApprovedSplit()">تطبيق: إنشاء طلبات التوزيع</t>
                            <t t-else="">توزيع الكميات</t>
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" t-on-click="this.load" t-att-disabled="this.state.loading">
                            <i class="fa fa-refresh me-1"/> تحديث
                        </button>
                    </div>
                </div>

                <div class="o_alt_table_shell">
                    <table class="table align-middle o_purchase_alternative_table">
                        <thead>
                        <tr>
                            <th class="o_alt_product_col">الصنف</th>
                            <th class="text-end o_alt_qty_col">المطلوب</th>
                            <th t-foreach="this.state.data.vendors" t-as="vendor" t-key="vendor.id" class="o_alt_vendor_col">
                                <div class="o_alt_vendor_card">
                                    <div class="o_alt_vendor_top">
                                        <span t-att-class="vendor.is_original ? 'o_alt_vendor_icon o_alt_vendor_original' : 'o_alt_vendor_icon'">
                                            <i t-att-class="vendor.is_original ? 'fa fa-star' : 'fa fa-truck'"/>
                                        </span>
                                        <div>
                                            <div class="o_alt_vendor_title" t-if="vendor.partner" t-esc="vendor.partner"/>
                                            <div class="o_alt_vendor_title text-muted" t-else="">اختر المورد</div>
                                            <div class="o_alt_vendor_tag" t-if="vendor.is_original">مورد طلب الشراء الأصلي</div>
                                        </div>
                                    </div>
                                    <select
                                        class="form-select form-select-sm"
                                        t-att-disabled="(vendor.is_original or this.state.data.state !== 'draft') ? true : undefined"
                                        t-on-change="(ev) => this.updateVendor(vendor, 'partner_id', ev)"
                                    >
                                        <option value="">— اختر المورد —</option>
                                        <option
                                            t-foreach="this.state.data.vendor_options"
                                            t-as="option"
                                            t-key="option.id"
                                            t-att-value="option.id"
                                            t-att-selected="option.id === vendor.partner_id ? true : undefined"
                                        >
                                            <t t-esc="option.name"/>
                                        </option>
                                    </select>
                                    <div class="o_alt_payment_terms">
                                        <label class="o_alt_vendor_tag mb-0"><i class="fa fa-money me-1"/> شروط الدفع</label>
                                        <select
                                            class="form-select form-select-sm"
                                            t-att-disabled="this.state.data.state !== 'draft' ? true : undefined"
                                            t-on-change="(ev) => this.updateVendor(vendor, 'payment_term_id', ev)"
                                        >
                                            <option value="">— اختر شروط الدفع —</option>
                                            <option
                                                t-foreach="this.state.data.payment_term_options"
                                                t-as="term"
                                                t-key="term.id"
                                                t-att-value="term.id"
                                                t-att-selected="term.id === vendor.payment_term_id ? true : undefined"
                                            >
                                                <t t-esc="term.name"/>
                                            </option>
                                        </select>
                                    </div>
                                    <label class="o_alt_vendor_tag mb-0"><i class="fa fa-calendar me-1"/> ميعاد التسليم</label>
                                    <input t-att-disabled="this.state.data.state !== 'draft' ? true : undefined"
                                        class="form-control form-control-sm"
                                        type="datetime-local"
                                        t-att-value="vendor.date_planned ? vendor.date_planned.replace(' ', 'T') : ''"
                                        t-on-change="(ev) => this.updateVendor(vendor, 'date_planned', ev)"
                                    />
                                </div>
                            </th>
                            <th class="text-end o_alt_qty_col">الموزع</th>
                            <th class="text-end o_alt_qty_col">المتبقي</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr t-foreach="this.state.data.rows" t-as="row" t-key="row.purchase_order_line_id" t-att-class="this.rowClass(row)">
                            <th class="o_alt_product_cell">
                                <div class="o_alt_product_name" t-esc="row.product"/>
                                <div class="o_alt_allocation_badge">
                                    <i t-att-class="'fa ' + this.allocationIcon(row)"/>
                                    <span t-esc="this.allocationLabel(row)"/>
                                    <span t-if="row.allocation_percent"> · <t t-esc="row.allocation_percent"/>%</span>
                                </div>
                            </th>
                            <td class="text-end">
                                <div class="o_alt_qty_value" t-esc="this.formatNumber(row.requested_qty)"/>
                                <div class="o_alt_uom" t-esc="row.uom"/>
                            </td>
                            <td t-foreach="row.cells" t-as="cell" t-key="cell.id" t-att-class="this.cellClass(cell)">
                                <div class="o_alt_cell_inputs">
                                    <div>
                                        <label><i class="fa fa-cubes me-1"/> الكمية</label>
                                        <input t-att-disabled="this.state.data.state !== 'draft' ? true : undefined" class="form-control form-control-sm text-end"
                                           type="number"
                                           step="0.01"
                                           t-att-value="cell.offered_qty"
                                           t-on-focus="this.selectInput"
                                           t-on-click="this.selectInput"
                                           t-on-change="(ev) => this.updateCell(cell, 'offered_qty', ev)"/>
                                    </div>
                                    <div>
                                        <label><i class="fa fa-tag me-1"/> السعر</label>
                                        <input t-att-disabled="this.state.data.state !== 'draft' ? true : undefined" class="form-control form-control-sm text-end o_alt_price_input"
                                           type="number"
                                           step="0.01"
                                           t-att-value="cell.price_unit"
                                           t-on-focus="this.selectInput"
                                           t-on-click="this.selectInput"
                                           t-on-keydown="(ev) => this.onPriceKeydown(cell, ev)"
                                           t-on-change="(ev) => this.updateCell(cell, 'price_unit', ev)"/>
                                    </div>
                                </div>
                                <div class="o_alt_cell_total">
                                    <span t-if="cell.is_lowest_price" class="o_alt_best_badge">
                                        <i class="fa fa-check-circle me-1"/> أفضل سعر
                                    </span>
                                    <span t-esc="this.formatMoney(cell.subtotal)"/>
                                </div>
                            </td>
                            <td class="text-end">
                                <div class="o_alt_qty_value" t-esc="this.formatNumber(row.allocated_qty)"/>
                                <div class="o_alt_uom" t-esc="row.uom"/>
                            </td>
                            <td t-att-class="row.remaining_qty &lt; 0 ? 'text-end o_alt_remaining_over' : 'text-end'">
                                <div class="o_alt_qty_value" t-esc="this.formatNumber(row.remaining_qty)"/>
                                <div class="o_alt_uom" t-esc="row.uom"/>
                            </td>
                        </tr>
                        </tbody>
                        <tfoot>
                        <tr>
                            <th colspan="2">إجمالي المورد / الإجراءات</th>
                            <td t-foreach="this.state.data.vendors" t-as="vendor" t-key="vendor.id">
                                <div class="o_alt_vendor_total" t-esc="this.formatMoney(vendor.amount_total)"/>
                                <div class="o_alt_footer_actions">
                                    <button t-att-class="this.isApprovedMain(vendor) ? 'btn btn-sm btn-success' : 'btn btn-sm btn-outline-primary'"
                                            t-att-disabled="this.state.data.state !== 'draft' and !this.isApprovedMain(vendor)"
                                            t-on-click="() => this.applyMain(vendor)">
                                        <i class="fa fa-thumb-tack me-1"/>
                                        <t t-if="this.isApprovedMain(vendor)">تطبيق القرار</t>
                                        <t t-else="">ترسية</t>
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" t-att-disabled="!this.authority.approved" t-on-click="() => this.createPO(vendor)">
                                        <i class="fa fa-file-o me-1"/> أمر شراء إضافي
                                    </button>
                                </div>
                            </td>
                            <td colspan="2"/>
                        </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="o_alt_opinion d-flex align-items-center gap-2 mt-2" dir="rtl">
                    <label class="fw-bold text-nowrap mb-0" for="o_alt_technical_opinion">الرأي الفني</label>
                    <input id="o_alt_technical_opinion" class="form-control form-control-sm" type="text"
                        placeholder="اكتب الرأي الفني في سطر واحد"
                        t-att-disabled="this.state.data.state === 'applied' or this.state.data.state === 'locked' ? true : undefined"
                        t-att-value="this.state.data.technical_opinion"
                        t-on-change="this.updateTechnicalOpinion"/>
                </div>
            </div>
        </div>
    </div>
</templates>
